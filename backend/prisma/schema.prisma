generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AuthProvider {
  EMAIL
  GOOGLE
  APPLE
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
  MODERATOR
  SUPPORT
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum Gender {
  MALE
  FEMALE
  NON_BINARY
  NON_GENDERED
  OTHER
  PREFER_NOT_TO_SAY
}

enum InterestGender {
  MALE
  FEMALE
  NON_GENDERED
}

enum SexualOrientation {
  HETEROSEXUAL
  HOMOSEXUAL
  BISEXUAL
  PANSEXUAL
  ASEXUAL
  OTHER
  PREFER_NOT_TO_SAY
}

enum CoachGender {
  MALE
  FEMALE
  NON_GENDERED
}

enum CoachPersonality {
  FRIENDLY
  BRO_VIBE
  SISTER_VIBE
  FUNNY
  CARING
  SERIOUS
  DIRECT
  SOFT
  EMPATHETIC
  THERAPIST
  DATING_EXPERT
  PROTECTIVE
  SARCASTIC
  MORE_DIRECTIVE
  LESS_DIRECTIVE
}

enum ConversationType {
  PRIVATE
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
}

enum MessageStatus {
  SENT
  DELIVERED
  READ
}

enum GuidanceMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum GuidanceConversationStatus {
  ACTIVE
  ARCHIVED
}

enum CoachDailyCheckInStatus {
  PENDING
  RUNNING
  SENT
  FAILED
}

enum SoulprintCategory {
  PERSONALITY
  CORE_VALUE
  INTEREST
  RELATIONSHIP_GOAL
  PARTNER_PREFERENCE
  COMMUNICATION_STYLE
  LOVE_LANGUAGE
  EMOTIONAL_NEED
  BOUNDARY
  STRENGTH
  CHALLENGE
  DISLIKE
  HABIT
  LIFESTYLE
  PAST_EXPERIENCE
  RELATIONSHIP_PATTERN
  DEAL_BREAKER
  IMPORTANT_PERSON
  IMPORTANT_EVENT
  LOCATION_PREFERENCE
  FUTURE_PLAN
  OTHER
}

enum SoulprintSource {
  USER_PROFILE
  USER_DECLARED
  USER_CONFIRMED
  AI_INFERRED
  MANUAL_USER_ENTRY
  SYSTEM_MIGRATION
  PEER_CONVERSATION
  COACH_CONVERSATION
  USER_FEEDBACK
}

enum SoulprintEntryStatus {
  PENDING_CONFIRMATION
  ACTIVE
  CONFIRMED
  REJECTED
  SUPERSEDED
  DELETED
}

enum SoulprintVisibility {
  PRIVATE
  GUIDANCE_ONLY
  MATCHING_ALLOWED
}

enum SoulprintSensitivity {
  NORMAL
  PERSONAL
  SENSITIVE
  HIGHLY_SENSITIVE
}

enum SoulprintExtractionJobStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
}

enum GrowthGoalStatus {
  SUGGESTED
  ACTIVE
  PAUSED
  COMPLETED
  ARCHIVED
}

enum GrowthJournalType {
  NOTE
  STEP_REFLECTION
  POST_DATE
  SAVED_ADVICE
}

model User {
  id                     String                    @id @default(uuid()) @db.Uuid
  email                  String                    @unique
  passwordHash           String?
  authProvider           AuthProvider              @default(EMAIL)
  providerId             String?
  role                   Role                      @default(USER)
  isActive               Boolean                   @default(true)
  accountStatus          AccountStatus             @default(ACTIVE)
  suspendedUntil         DateTime?
  moderationReason       String?
  emailVerified          Boolean                   @default(false)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  lastLoginAt            DateTime?
  refreshTokens          RefreshToken[]
  authIdentities         AuthIdentity[]
  passwordResetToken     PasswordResetToken?
  pushDevices            PushDevice[]
  notificationPreference NotificationPreference?
  profile                Profile?
  coach                  Coach?
  conversations          ConversationParticipant[]
  messages               Message[]
  chatMedia              ChatMedia[]
  blocksCreated          Block[]                   @relation("Blocker")
  blocksReceived         Block[]                   @relation("Blocked")
  guidanceConversations  GuidanceConversation[]
  memories               UserMemory[]
  soulprint              Soulprint?
  soulprintExtractionJob SoulprintExtractionJob?
  soulprintConsent       SoulprintConsent?
  soulprintConsentEvents SoulprintConsentEvent[]
  peerAnalysisJobs       PeerConversationAnalysisJob[]
  growthGoals            GrowthGoal[]
  growthExercises        GrowthExercise[]
  growthCheckIns         GrowthCheckIn[]
  growthJournalEntries   GrowthJournalEntry[]
  growthEvents           GrowthEvent[]
  growthPreferences      GrowthPreference?
  growthPathEnrollments  GrowthPathEnrollment[]
  coachDailyCheckIns     CoachDailyCheckIn[]
  reportsCreated         Report[]                  @relation("ReportReporter")
  reportsReceived        Report[]                  @relation("ReportSubject")
  reportsAssigned        Report[]                  @relation("ReportModerator")
  adminNotesAuthored     AdminNote[]               @relation("AdminNoteAuthor")
  adminNotesReceived     AdminNote[]               @relation("AdminNoteSubject")
  auditLogs              AuditLog[]                @relation("AuditActor")
  matchesCreated         Match[]                   @relation("MatchUser")
  matchesReceived        Match[]                   @relation("MatchMatchedUser")
  twoFactorSecret        String?
  twoFactorEnabled       Boolean                   @default(false)
  twoFactorRecoveryCodes Json?

  @@unique([authProvider, providerId])
}

model SoulprintConsent {
  id                           String   @id @default(uuid()) @db.Uuid
  userId                       String   @unique @db.Uuid
  conversationAnalysisAllowed Boolean
  consentVersion               String
  consentedAt                  DateTime?
  withdrawnAt                  DateTime?
  analysisAllowedFrom          DateTime?
  createdAt                    DateTime @default(now())
  updatedAt                    DateTime @updatedAt
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([conversationAnalysisAllowed, analysisAllowedFrom])
}

model SoulprintConsentEvent {
  id                           String   @id @default(uuid()) @db.Uuid
  userId                       String   @db.Uuid
  conversationAnalysisAllowed Boolean
  consentVersion               String
  changedAt                    DateTime @default(now())
  user                         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, changedAt])
}

model PeerConversationAnalysisJob {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @db.Uuid
  conversationId  String   @db.Uuid
  runAt           DateTime @default(now())
  attempts        Int      @default(0)
  lockedAt        DateTime?
  lastProcessedAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, conversationId])
  @@index([runAt, lockedAt])
}

model AuthIdentity {
  id         String       @id @default(uuid()) @db.Uuid
  userId     String       @db.Uuid
  provider   AuthProvider
  providerId String
  email      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
}

model Match {
  id                 String    @id @default(uuid()) @db.Uuid
  userId             String    @db.Uuid
  matchedUserId      String    @db.Uuid
  score              Int
  reciprocalScore    Int
  reasons            Json?
  createdAt          DateTime  @default(now())
  viewedAt           DateTime?
  respondedAt        DateTime?
  response           String?
  semanticScore      Int?
  semanticConfidence Float?
  semanticModel      String?
  semanticAnalysis   Json?
  user               User      @relation("MatchUser", fields: [userId], references: [id], onDelete: Cascade)
  matchedUser        User      @relation("MatchMatchedUser", fields: [matchedUserId], references: [id], onDelete: Cascade)

  @@unique([userId, matchedUserId])
  @@index([userId, createdAt])
  @@index([matchedUserId, createdAt])
}

model Report {
  id                  String         @id @default(uuid()) @db.Uuid
  reporterId          String         @db.Uuid
  reportedUserId      String         @db.Uuid
  conversationId      String?        @db.Uuid
  messageId           String?        @db.Uuid
  reason              String
  description         String?        @db.Text
  priority            ReportPriority @default(MEDIUM)
  status              ReportStatus   @default(OPEN)
  assignedModeratorId String?        @db.Uuid
  resolution          String?        @db.Text
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  resolvedAt          DateTime?
  reporter            User           @relation("ReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser        User           @relation("ReportSubject", fields: [reportedUserId], references: [id], onDelete: Cascade)
  assignedModerator   User?          @relation("ReportModerator", fields: [assignedModeratorId], references: [id], onDelete: SetNull)

  @@index([status, priority, createdAt])
  @@index([reportedUserId, createdAt])
  @@index([assignedModeratorId, status])
}

model AdminNote {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  authorId  String   @db.Uuid
  content   String   @db.Text
  createdAt DateTime @default(now())
  user      User     @relation("AdminNoteSubject", fields: [userId], references: [id], onDelete: Cascade)
  author    User     @relation("AdminNoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  resource   String
  resourceId String?
  oldValue   Json?
  newValue   Json?
  ipAddress  String?
  success    Boolean  @default(true)
  createdAt  DateTime @default(now())
  actor      User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@index([resource, action])
}

model AppSetting {
  key         String   @id
  value       Json
  description String?
  updatedBy   String?  @db.Uuid
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model LlmUsage {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String?  @db.Uuid
  feature       String
  provider      String
  model         String
  inputTokens   Int      @default(0)
  outputTokens  Int      @default(0)
  cachedTokens  Int      @default(0)
  latencyMs     Int?
  estimatedCost Decimal? @db.Decimal(12, 6)
  success       Boolean  @default(true)
  errorCode     String?
  createdAt     DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([provider, model, createdAt])
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @db.Uuid
  tokenHash String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model PushDevice {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  token      String   @unique
  platform   String
  active     Boolean  @default(true)
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
}

model NotificationPreference {
  id                     String   @id @default(uuid()) @db.Uuid
  userId                 String   @unique @db.Uuid
  newMessages            Boolean  @default(true)
  coachReflections       Boolean  @default(true)
  soulprintConfirmations Boolean  @default(true)
  growthReminders        Boolean  @default(false)
  quietHoursEnabled      Boolean  @default(false)
  quietHoursStart        Int      @default(22)
  quietHoursEnd          Int      @default(8)
  timezone               String   @default("UTC")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id            String                    @id @default(uuid()) @db.Uuid
  type          ConversationType          @default(PRIVATE)
  pairKey       String                    @unique
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime?
  participants  ConversationParticipant[]
  messages      Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  id             String       @id @default(uuid()) @db.Uuid
  conversationId String       @db.Uuid
  userId         String       @db.Uuid
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@index([userId])
}

model Message {
  id              String        @id @default(uuid()) @db.Uuid
  conversationId  String        @db.Uuid
  senderId        String        @db.Uuid
  clientMessageId String
  content         String?
  type            MessageType   @default(TEXT)
  mediaUrl        String?
  mediaMimeType   String?
  mediaSize       Int?
  mediaDurationMs Int?
  status          MessageStatus @default(SENT)
  isEdited        Boolean       @default(false)
  editedAt        DateTime?
  isDeleted       Boolean       @default(false)
  deletedAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  conversation    Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender          User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@unique([senderId, clientMessageId])
  @@index([conversationId, createdAt])
  @@index([senderId])
}

model ChatMedia {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @db.Uuid
  mimeType  String
  size      Int
  data      Bytes    @db.ByteA
  createdAt DateTime @default(now())
  owner     User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}

model Block {
  id        String   @id @default(uuid()) @db.Uuid
  blockerId String   @db.Uuid
  blockedId String   @db.Uuid
  createdAt DateTime @default(now())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String
  userId     String    @db.Uuid
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  deviceInfo String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Profile {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @unique @db.Uuid
  firstName           String
  birthDate           DateTime
  gender              Gender
  sexualOrientation   SexualOrientation
  interestedInGender  InterestGender?
  country             String
  city                String
  occupation          String?
  onboardingCompleted Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  user                User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coach {
  id                 String             @id @default(uuid()) @db.Uuid
  userId             String             @unique @db.Uuid
  name               String
  gender             CoachGender?
  personality        CoachPersonality?
  traits             CoachPersonality[] @default([])
  customInstructions String?
  speakingStyle      String?
  adviceStyle        String?
  appearance         String?
  humorLevel         Int                @default(50)
  empathyLevel       Int                @default(50)
  directnessLevel    Int                @default(50)
  energyLevel        Int                @default(50)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  user               User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GuidanceConversation {
  id                String                     @id @default(uuid()) @db.Uuid
  userId            String                     @db.Uuid
  title             String?
  status            GuidanceConversationStatus @default(ACTIVE)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  lastMessageAt     DateTime?
  user              User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages          GuidanceMessage[]
  soulprintEvidence SoulprintEvidence[]

  @@index([userId, lastMessageAt])
  @@index([userId, status, lastMessageAt])
}

model GuidanceMessage {
  id                String               @id @default(uuid()) @db.Uuid
  conversationId    String               @db.Uuid
  role              GuidanceMessageRole
  content           String?
  provider          String?
  model             String?
  isEdited          Boolean              @default(false)
  editedAt          DateTime?
  isDeleted         Boolean              @default(false)
  deletedAt         DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  conversation      GuidanceConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  soulprintEvidence SoulprintEvidence[]

  @@index([conversationId, createdAt])
}

model CoachDailyCheckIn {
  id        String                  @id @default(uuid()) @db.Uuid
  userId    String                  @db.Uuid
  dayKey    String
  status    CoachDailyCheckInStatus @default(PENDING)
  attempts  Int                     @default(0)
  lockedAt  DateTime?
  sentAt    DateTime?
  messageId String?                 @db.Uuid
  lastError String?
  createdAt DateTime                @default(now())
  updatedAt DateTime                @updatedAt
  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dayKey])
  @@index([status, createdAt])
}

model UserMemory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  content   String
  category  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model Soulprint {
  id                    String             @id @default(uuid()) @db.Uuid
  userId                String             @unique @db.Uuid
  summary               Json?
  legacyData            Json?
  summaryVersion        Int                @default(1)
  completenessScore     Int                @default(0)
  lastExtractedAt       DateTime?
  lastSummarizedAt      DateTime?
  lastAnalyzedMessageId String?            @db.Uuid
  promptVersion         String?
  extractionRunningAt   DateTime?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  deletedAt             DateTime?
  user                  User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries               SoulprintEntry[]
  versions              SoulprintVersion[]
}

model SoulprintEntry {
  id                    String                 @id @default(uuid()) @db.Uuid
  soulprintId           String                 @db.Uuid
  category              SoulprintCategory
  key                   String?
  value                 String                 @db.Text
  normalizedValue       String?                @db.Text
  fingerprint           String
  source                SoulprintSource
  status                SoulprintEntryStatus
  visibility            SoulprintVisibility    @default(PRIVATE)
  sensitivity           SoulprintSensitivity   @default(NORMAL)
  confidence            Float
  importance            Int                    @default(50)
  matchingWeight        Int                    @default(50)
  firstObservedAt       DateTime               @default(now())
  lastObservedAt        DateTime               @default(now())
  confirmedAt           DateTime?
  rejectedAt            DateTime?
  deletedAt             DateTime?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  semanticData          Json?
  semanticModel         String?
  semanticPromptVersion String?
  semanticSourceHash    String?
  semanticAnalyzedAt    DateTime?
  soulprint             Soulprint              @relation(fields: [soulprintId], references: [id], onDelete: Cascade)
  evidence              SoulprintEvidence[]
  changes               SoulprintEntryChange[]

  @@unique([soulprintId, fingerprint])
  @@index([soulprintId, category, status])
  @@index([soulprintId, visibility])
}

model SoulprintEvidence {
  id                String                @id @default(uuid()) @db.Uuid
  entryId           String                @db.Uuid
  messageId         String?               @db.Uuid
  conversationId    String?               @db.Uuid
  sourceExcerptHash String?
  createdAt         DateTime              @default(now())
  entry             SoulprintEntry        @relation(fields: [entryId], references: [id], onDelete: Cascade)
  message           GuidanceMessage?      @relation(fields: [messageId], references: [id], onDelete: SetNull)
  conversation      GuidanceConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([entryId, messageId])
  @@index([entryId])
  @@index([messageId])
}

model SoulprintEntryChange {
  id            String         @id @default(uuid()) @db.Uuid
  entryId       String         @db.Uuid
  changeType    String
  previousValue Json?
  newValue      Json?
  changedBy     String
  reason        String?
  createdAt     DateTime       @default(now())
  entry         SoulprintEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, createdAt])
}

model SoulprintVersion {
  id          String    @id @default(uuid()) @db.Uuid
  soulprintId String    @db.Uuid
  version     Int
  snapshot    Json
  createdAt   DateTime  @default(now())
  soulprint   Soulprint @relation(fields: [soulprintId], references: [id], onDelete: Cascade)

  @@unique([soulprintId, version])
}

model SoulprintExtractionJob {
  id                 String                       @id @default(uuid()) @db.Uuid
  userId             String                       @unique @db.Uuid
  conversationId     String?                      @db.Uuid
  status             SoulprintExtractionJobStatus @default(PENDING)
  attempts           Int                          @default(0)
  requestedRevision  Int                          @default(1)
  processingRevision Int                          @default(0)
  runAt              DateTime                     @default(now())
  lockedAt           DateTime?
  completedAt        DateTime?
  lastErrorCode      String?
  createdAt          DateTime                     @default(now())
  updatedAt          DateTime                     @updatedAt
  user               User                         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, runAt])
}

model SoulprintExtractionMetric {
  id              String   @id @default(uuid()) @db.Uuid
  outcome         String
  code            String
  count           Int      @default(0)
  totalDurationMs BigInt   @default(0)
  lastOccurredAt  DateTime @default(now())

  @@unique([outcome, code])
}

model GrowthGoal {
  id               String                @id @default(uuid()) @db.Uuid
  userId           String                @db.Uuid
  title            String
  description      String?
  targetSteps      Int                   @default(5)
  completedSteps   Int                   @default(0)
  status           GrowthGoalStatus      @default(ACTIVE)
  completedAt      DateTime?
  targetDate       DateTime?
  source           String                @default("MANUAL")
  version          Int                   @default(1)
  pathEnrollmentId String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises        GrowthExercise[]
  journalEntries   GrowthJournalEntry[]
  pathEnrollment   GrowthPathEnrollment? @relation(fields: [pathEnrollmentId], references: [id], onDelete: SetNull)

  @@index([userId, status, updatedAt])
}

model GrowthExercise {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String      @db.Uuid
  dayKey      String
  kind        String
  title       String
  description String
  durationMin Int         @default(5)
  completedAt DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  goalId      String?     @db.Uuid
  note        String?
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal        GrowthGoal? @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@unique([userId, dayKey])
  @@index([userId, createdAt])
}

model GrowthCheckIn {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  weekKey    String
  mood       Int
  reflection String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, weekKey])
  @@index([userId, updatedAt])
}

model GrowthJournalEntry {
  id        String            @id @default(uuid()) @db.Uuid
  userId    String            @db.Uuid
  goalId    String?           @db.Uuid
  type      GrowthJournalType @default(NOTE)
  title     String?
  content   String            @db.Text
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal      GrowthGoal?       @relation(fields: [goalId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([goalId, createdAt])
}

model GrowthEvent {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @db.Uuid
  entityType String
  entityId   String?  @db.Uuid
  type       String
  title      String
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model GrowthPreference {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @unique @db.Uuid
  timezone         String   @default("UTC")
  remindersEnabled Boolean  @default(false)
  reminderHour     Int      @default(19)
  analyticsConsent Boolean  @default(false)
  gentleStreaks    Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GrowthPathEnrollment {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @db.Uuid
  pathKey        String
  title          String
  completedUnits Int          @default(0)
  totalUnits     Int          @default(5)
  completedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  goals          GrowthGoal[]

  @@unique([userId, pathKey])
  @@index([userId, updatedAt])
}
